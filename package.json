    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.2",
